<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="froldanLavaXpress.Views.vLogin"
             Title="Iniciar sesión">

    <VerticalStackLayout Spacing="10" Padding="20">

        <Image Source="lavaxpress.png" HeightRequest="140" />
        <Label Text="LAVAXPRESS MÓVIL" Style="{StaticResource estiloTitulo}" />

        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="110,*" RowSpacing="10">
            <Label Text="Usuario:" Grid.Row="0" Grid.Column="0" Style="{StaticResource estiloEtiqueta}" />
            <Entry x:Name="txtUsuario" Grid.Row="0" Grid.Column="1" Placeholder="Ingrese su usuario" />

            <Label Text="Contraseña:" Grid.Row="1" Grid.Column="0" Style="{StaticResource estiloEtiqueta}" />
            <Entry x:Name="txtClave" Grid.Row="1" Grid.Column="1" Placeholder="Ingrese su contraseña" IsPassword="True" />
        </Grid>

        <Button Text="Iniciar sesión" Style="{StaticResource estiloBoton}" Clicked="btnIngresar_Clicked" />
    </VerticalStackLayout>
</ContentPage>