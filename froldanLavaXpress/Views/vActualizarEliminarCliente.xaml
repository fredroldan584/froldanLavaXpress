<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="froldanLavaXpress.Views.vActualizarEliminarCliente"
             Title="Actualizar cliente">

    <VerticalStackLayout Padding="20" Spacing="10">
        <Label Text="ACTUALIZAR - ELIMINAR CLIENTE" Style="{StaticResource estiloTitulo}" />

        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="110,*" RowSpacing="10">
            <Label Text="Código:" Grid.Row="0" Grid.Column="0" Style="{StaticResource estiloEtiqueta}" />
            <Entry x:Name="txtCodigo" Grid.Row="0" Grid.Column="1" IsEnabled="False" />

            <Label Text="Nombre:" Grid.Row="1" Grid.Column="0" Style="{StaticResource estiloEtiqueta}" />
            <Entry x:Name="txtNombre" Grid.Row="1" Grid.Column="1" />

            <Label Text="Apellido:" Grid.Row="2" Grid.Column="0" Style="{StaticResource estiloEtiqueta}" />
            <Entry x:Name="txtApellido" Grid.Row="2" Grid.Column="1" />

            <Label Text="Teléfono:" Grid.Row="3" Grid.Column="0" Style="{StaticResource estiloEtiqueta}" />
            <Entry x:Name="txtTelefono" Grid.Row="3" Grid.Column="1" Keyboard="Numeric" MaxLength="10" />

            <Label Text="Dirección:" Grid.Row="4" Grid.Column="0" Style="{StaticResource estiloEtiqueta}" />
            <Entry x:Name="txtDireccion" Grid.Row="4" Grid.Column="1" />
        </Grid>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button Text="Actualizar" Grid.Column="0" Style="{StaticResource estiloBoton}"
                    Clicked="btnActualizar_Clicked" />
            <Button Text="Eliminar" Grid.Column="1" Style="{StaticResource estiloBoton}"
                    BackgroundColor="IndianRed" Clicked="btnEliminar_Clicked" />
        </Grid>
    </VerticalStackLayout>
</ContentPage>