<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="froldanLavaXpress.Views.vPedidos"
             Title="Pedidos">

    <VerticalStackLayout Padding="10" Spacing="10">
        <Label Text="PEDIDOS" Style="{StaticResource estiloTitulo}" />

        <ListView x:Name="listaPedidos" ItemSelected="listaPedidos_ItemSelected">
            <!-- Encabezado -->
            <ListView.Header>
                <Grid ColumnDefinitions="50,*,100,*,80,100" Padding="10" BackgroundColor="#1E88E5">
                    <Label Grid.Column="0" Text="N°"       FontAttributes="Bold" TextColor="White" />
                    <Label Grid.Column="1" Text="Cliente"  FontAttributes="Bold" TextColor="White" />
                    <Label Grid.Column="2" Text="Fecha"    FontAttributes="Bold" TextColor="White" />
                    <Label Grid.Column="3" Text="Servicio" FontAttributes="Bold" TextColor="White" />
                    <Label Grid.Column="4" Text="Total"    FontAttributes="Bold" TextColor="White" />
                    <Label Grid.Column="5" Text="Estado"   FontAttributes="Bold" TextColor="White" />
                </Grid>
            </ListView.Header>

            <!-- Filas -->
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Grid ColumnDefinitions="50,*,100,*,80,100" Padding="10">
                            <Label Grid.Column="0" Text="{Binding codigo}" />
                            <Label Grid.Column="1" Text="{Binding cliente}" />
                            <Label Grid.Column="2" Text="{Binding fecha}" />
                            <Label Grid.Column="3" Text="{Binding servicio}" />
                            <Label Grid.Column="4" Text="{Binding total, StringFormat='${0:0.00}'}" />
                            <Label Grid.Column="5" Text="{Binding estado}" FontAttributes="Bold" />
                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </VerticalStackLayout>
</ContentPage>