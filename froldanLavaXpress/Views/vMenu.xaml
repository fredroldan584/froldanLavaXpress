<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="froldanLavaXpress.Views.vMenu"
             Title="Menú principal">

    <VerticalStackLayout Spacing="12" Padding="20">

        <Image Source="logo.png" HeightRequest="100" />
        <Label x:Name="lblBienvenida" Style="{StaticResource estiloTitulo}" />

        <Button Text="👥  Clientes" Style="{StaticResource estiloBoton}" Clicked="btnClientes_Clicked" />
        <Button Text="🧺  Nuevo pedido" Style="{StaticResource estiloBoton}" Clicked="btnProximamente_Clicked" />
        <Button Text="📋  Pedidos" Style="{StaticResource estiloBoton}" Clicked="btnProximamente_Clicked" />
        <Button Text="🚚  Entregas a domicilio" Style="{StaticResource estiloBoton}" Clicked="btnProximamente_Clicked" />
        <Button Text="Cerrar sesión" Style="{StaticResource estiloBoton}" BackgroundColor="Gray"
                Clicked="btnCerrarSesion_Clicked" />
    </VerticalStackLayout>
</ContentPage>